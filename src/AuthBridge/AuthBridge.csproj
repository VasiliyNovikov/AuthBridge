<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>authbridge</AssemblyName>
    <RootNamespace>AuthBridge</RootNamespace>
    <Features>$(Features);runtime-async=on</Features>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <!-- `dotnet publish -r <rid>` produces one self-contained, trimmed executable. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>AuthBridge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tray icon adds a status dot to its images. -->
    <EmbeddedResource Include="AuthBridge.ico" LogicalName="AuthBridge.ico" />
    <InternalsVisibleTo Include="AuthBridge.Tests" />
  </ItemGroup>

</Project>
