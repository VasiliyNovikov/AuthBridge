<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- A publish RID takes precedence over the build machine; tests use their native target. -->
    <TargetFramework Condition="$(RuntimeIdentifier.StartsWith('win-')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">net11.0-windows</TargetFramework>
    <EnableWindowsTargeting Condition="'$(TargetFramework)' == 'net11.0-windows'">true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
